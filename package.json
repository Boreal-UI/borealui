{
  "name": "@boreal-ui/workspace",
  "version": "0.1.423",
  "readme": "README.md",
  "description": "Workspace for Boreal UI scoped packages",
  "author": "Davin Chiupka",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "audit:types": "tsc --noEmit && npm run audit:types:cypress",
    "audit:types:cypress": "tsc -p cypress/tsconfig.json --noEmit",
    "audit:lint": "npm run lint",
    "audit:styles": "stylelint \"src/**/*.{scss,css}\"",
    "audit:docs": "node scripts/generate-component-docs.cjs --check",
    "audit:style-sidecars": "node scripts/patchStyleSidecars.cjs --check",
    "audit:root-entrypoints": "node scripts/patchRootEntrypoints.cjs --check",
    "audit:root-css-bundles": "node scripts/auditRootCssBundles.cjs",
    "audit:esm-only": "node scripts/auditEsmOnly.cjs",
    "audit:docs-separation": "node scripts/auditDocsSeparation.cjs",
    "audit:test": "jest --coverage",
    "audit:build": "npm run build && npm run audit:style-sidecars && npm run audit:root-entrypoints && npm run audit:root-css-bundles && npm run audit:esm-only",
    "audit:package": "npm run audit:package:core && npm run audit:package:next && npm run audit:package:types && npm run audit:package:docs && npm run audit:package:cli",
    "audit:package:core": "npm run stage:core-package && npm pack ./packages/core --dry-run --silent",
    "audit:package:next": "npm run stage:next-package && npm pack ./packages/next --dry-run --silent",
    "audit:package:types": "npm run stage:types-package && npm pack ./packages/types --dry-run --silent",
    "audit:package:docs": "npm run stage:docs-package && npm pack ./packages/docs --dry-run --silent",
    "audit:package:cli": "npm run stage:cli-package && npm pack ./packages/cli --dry-run --silent",
    "audit:publint": "npm run stage:split-packages && publint packages/core --strict --pack false && publint packages/next --strict --pack false && publint packages/types --strict --pack false && publint packages/docs --strict --pack false && publint packages/cli --strict --pack false",
    "audit:attw": "npm run stage:split-packages && node scripts/auditAttw.cjs",
    "audit:package-quality": "npm run audit:package && npm run audit:docs-separation && npm run audit:publint && npm run audit:attw",
    "audit:dependencies": "npm run audit:dependencies:runtime && npm run audit:dependencies:all",
    "audit:dependencies:runtime": "npm audit --omit=dev --audit-level=high",
    "audit:dependencies:all": "npm audit --audit-level=critical",
    "audit:security": "npm run audit:dependencies && npm run sbom",
    "audit": "npm run audit:docs && npm run audit:types && npm run audit:lint && npm run audit:styles && npm run audit:test && npm run audit:build && npm run audit:package-quality",
    "cli:check": "node --check packages/cli/src/index.js",
    "dev": "vite",
    "clean": "rimraf dist",
    "boreal": "ts-node ./scripts/boreal.cjs",
    "build:core": "vite build --config vite.config.core.ts",
    "build:next": "vite build --config vite.config.next.ts",
    "build:docs": "vite build --config vite.config.docs.ts",
    "build:types": "tsc -p tsconfig.build.json && node scripts/generateTypesBarrel.cjs && node scripts/patchDeclarations.cjs",
    "build:types:public": "node scripts/generateTypesBarrel.cjs && node scripts/patchDeclarations.cjs",
    "build:css-next": "sass --load-path=node_modules src/styles/globals.scss src/styles/style.css --no-source-map",
    "build": "npm run gen:docs && npm run clean && npm run build:core && npm run build:next && npm run patch:root-entrypoints && npm run patch:useClient && npm run patch:style-sidecars && npm run build:docs && npm run build:types && npm run build:types:public",
    "clean:package-builds": "node scripts/cleanPackageBuilds.cjs",
    "clean:package-builds:dry-run": "node scripts/cleanPackageBuilds.cjs --dry-run",
    "refresh:packages": "npm run clean:package-builds && npm run build && npm run stage:split-packages",
    "version:packages": "node scripts/updatePackageVersions.cjs",
    "stage:core-package": "node scripts/stageSplitPackage.cjs core",
    "stage:next-package": "node scripts/stageSplitPackage.cjs next",
    "stage:types-package": "node scripts/stageSplitPackage.cjs types",
    "stage:docs-package": "node scripts/stageSplitPackage.cjs docs",
    "stage:cli-package": "node scripts/stageSplitPackage.cjs cli",
    "stage:split-packages": "node scripts/stageSplitPackage.cjs all",
    "pack:core": "npm run build && npm run stage:core-package && npm pack ./packages/core",
    "pack:next": "npm run build && npm run stage:next-package && npm pack ./packages/next",
    "pack:types": "npm run build && npm run stage:types-package && npm pack ./packages/types",
    "pack:docs": "npm run build && npm run stage:docs-package && npm pack ./packages/docs",
    "pack:cli": "npm run stage:cli-package && npm pack ./packages/cli",
    "pack:split": "npm run refresh:packages && npm pack ./packages/types && npm pack ./packages/core && npm pack ./packages/next && npm pack ./packages/docs && npm pack ./packages/cli",
    "lint:styles": "stylelint '**/*.{css,scss}'",
    "lint:styles:fix": "stylelint '**/*.{css,scss}' --fix",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" \"cypress/**/*.{ts,tsx}\" \"*.config.ts\" --fix",
    "lint:all": "eslint . --max-warnings=0",
    "check:sync": "node scripts/checkSync.cjs",
    "gen:entrypoints": "node scripts/generateEntryPoints.cjs",
    "gen:exports": "node scripts/generateExports.cjs",
    "gen:component": "node scripts/addComponent.cjs",
    "gen:docs": "node scripts/generate-component-docs.cjs",
    "patch:useClient": "node scripts/patchUseClient.cjs",
    "patch:style-sidecars": "node scripts/patchStyleSidecars.cjs",
    "patch:root-entrypoints": "node scripts/patchRootEntrypoints.cjs",
    "test": "jest",
    "test:a11y": "jest --runInBand --testNamePattern=\"(accessibility|axe) violations\"",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "cypress:open": "cypress open --component",
    "cypress:run": "cypress run --component",
    "prepare": "tsc -p tsconfig.build.json && npm run build",
    "playground": "vite --config playground/vite.config.ts",
    "storybook:core": "storybook dev -p 6006 -c .storybook-core",
    "storybook:next": "storybook dev -p 6007 -c .storybook-next",
    "storybook:build:core": "storybook build  --output-dir ./storybook-core-json -c .storybook-core",
    "storybook:build:next": "storybook build  --output-dir ./storybook-next-json -c .storybook-next",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"cypress/**/*.{ts,tsx}\" \"*.config.ts\" --max-warnings=0",
    "sbom": "cyclonedx-npm --output-format JSON --output-file bom.cdx.json --validate --mc-type library"
  },
  "keywords": [
    "react",
    "component-library",
    "nextjs",
    "scss",
    "ui",
    "boreal",
    "design-system"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@babel/core": "^7.29.7",
    "@chromatic-com/storybook": "^5.2.1",
    "@cyclonedx/cyclonedx-npm": "5.0.0",
    "@eslint/js": "^9.34.0",
    "@storybook/addon-docs": "10.5.7",
    "@storybook/nextjs-vite": "10.5.7",
    "@storybook/react-vite": "10.5.7",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.2",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^6.0.5",
    "axe-core": "^4.11.4",
    "cypress": "^15.20.0",
    "cypress-axe": "^1.7.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.34.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-storybook": "10.5.7",
    "fast-glob": "^3.3.3",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "next": "^16.3.0",
    "publint": "^0.3.21",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "rimraf": "^6.1.3",
    "sanitize-html": "^2.17.5",
    "sass": "^1.94.2",
    "storybook": "10.5.7",
    "stylelint": "^16.19.0",
    "stylelint-config-standard-scss": "^14.0.0",
    "stylelint-scss": "^6.11.1",
    "ts-jest": "^29.4.9",
    "ts-morph": "^27.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^8.2.1",
    "vite-plugin-lib-inject-css": "^2.2.2"
  },
  "overrides": {
    "storybook": "$storybook"
  },
  "private": true
}
