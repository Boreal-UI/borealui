{
  "name": "@boreal-ui/workspace",
  "version": "0.0.9011",
  "readme": "README.md",
  "description": "Workspace for Boreal UI scoped packages",
  "author": "Davin Chiupka",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "audit:types": "tsc --noEmit",
    "audit:lint": "npm run lint",
    "audit:styles": "stylelint \"src/**/*.{scss,css}\"",
    "audit:style-sidecars": "node scripts/patchStyleSidecars.cjs --check",
    "audit:test": "jest --coverage",
    "audit:build": "npm run build && npm run audit:style-sidecars",
    "audit:package": "npm run audit:package:core && npm run audit:package:next && npm run audit:package:types && npm run audit:package:cli",
    "audit:package:core": "npm run stage:core-package && npm pack ./packages/core --dry-run --silent",
    "audit:package:next": "npm run stage:next-package && npm pack ./packages/next --dry-run --silent",
    "audit:package:types": "npm run stage:types-package && npm pack ./packages/types --dry-run --silent",
    "audit:package:cli": "npm run stage:cli-package && npm pack ./packages/cli --dry-run --silent",
    "audit:publint": "npm run stage:split-packages && publint packages/core --strict --pack false && publint packages/next --strict --pack false && publint packages/types --strict --pack false && publint packages/cli --strict --pack false",
    "audit:attw": "npm run stage:split-packages && node scripts/auditAttw.cjs",
    "audit:package-quality": "npm run audit:package && npm run audit:publint && npm run audit:attw",
    "audit": "npm run audit:types && npm run audit:lint && npm run audit:styles && npm run audit:test && npm run audit:build && npm run audit:package-quality",
    "cli:check": "node --check packages/cli/src/index.js",
    "dev": "vite",
    "clean": "rimraf dist",
    "boreal": "ts-node ./scripts/boreal.cjs",
    "build:core": "vite build --config vite.config.core.ts",
    "build:next": "vite build --config vite.config.next.ts",
    "build:docs": "tsc -p tsconfig.docs.json --incremental false && node scripts/patchGeneratedDocsImports.cjs",
    "build:types": "tsc -p tsconfig.build.json && node scripts/generateTypesBarrel.cjs && node scripts/patchDeclarations.cjs",
    "build:types:public": "node scripts/generateTypesBarrel.cjs && node scripts/patchDeclarations.cjs",
    "build:css-next": "sass --load-path=node_modules src/styles/globals.scss src/styles/style.css --no-source-map",
    "build": "npm run clean && npm run build:core && npm run build:next && npm run patch:useClient && npm run patch:style-sidecars && npm run build:docs && npm run build:types && npm run build:types:public",
    "version:packages": "node scripts/updatePackageVersions.cjs",
    "stage:core-package": "node scripts/stageSplitPackage.cjs core",
    "stage:next-package": "node scripts/stageSplitPackage.cjs next",
    "stage:types-package": "node scripts/stageSplitPackage.cjs types",
    "stage:cli-package": "node scripts/stageSplitPackage.cjs cli",
    "stage:split-packages": "node scripts/stageSplitPackage.cjs all",
    "pack:core": "npm run build && npm run stage:core-package && npm pack ./packages/core",
    "pack:next": "npm run build && npm run stage:next-package && npm pack ./packages/next",
    "pack:types": "npm run build && npm run stage:types-package && npm pack ./packages/types",
    "pack:cli": "npm run stage:cli-package && npm pack ./packages/cli",
    "pack:split": "npm run build && npm run stage:split-packages && npm pack ./packages/types && npm pack ./packages/core && npm pack ./packages/next && npm pack ./packages/cli",
    "lint:styles": "stylelint '**/*.{css,scss}'",
    "lint:styles:fix": "stylelint '**/*.{css,scss}' --fix",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" \"cypress/**/*.{ts,tsx}\" \"*.config.ts\" --fix",
    "lint:all": "eslint . --max-warnings=0",
    "check:sync": "node scripts/checkSync.cjs",
    "gen:entrypoints": "node scripts/generateEntryPoints.cjs",
    "gen:exports": "node scripts/generateExports.cjs",
    "gen:component": "node scripts/addComponent.cjs",
    "gen:docs": "ts-node scripts/generate-component-docs.cjs",
    "patch:useClient": "node scripts/patchUseClient.cjs",
    "patch:style-sidecars": "node scripts/patchStyleSidecars.cjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "cypress:open": "cypress open --component",
    "cypress:run": "cypress run --component",
    "prepare": "tsc -p tsconfig.build.json && npm run build",
    "playground": "vite --config playground/vite.config.ts",
    "storybook:core": "storybook dev -p 6006 -c .storybook-core",
    "storybook:next": "storybook dev -p 6007 -c .storybook-next",
    "storybook:build:core": "storybook build  --output-dir ./storybook-core-json -c .storybook-core",
    "storybook:build:next": "storybook build  --output-dir ./storybook-next-json -c .storybook-next",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"cypress/**/*.{ts,tsx}\" \"*.config.ts\" --max-warnings=0"
  },
  "keywords": [
    "react",
    "component-library",
    "nextjs",
    "scss",
    "ui",
    "boreal",
    "design-system"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@axe-core/react": "^4.10.1",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-react": "^7.26.3",
    "@babel/preset-typescript": "^7.28.5",
    "@chromatic-com/storybook": "^5.2.1",
    "@eslint/js": "^9.34.0",
    "@jest/globals": "^30.3.0",
    "@storybook/addon-docs": "10.4.2",
    "@storybook/addon-onboarding": "10.4.2",
    "@storybook/nextjs-vite": "10.4.2",
    "@storybook/react-vite": "10.4.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.11.4",
    "babel-loader": "^10.0.0",
    "css-loader": "^7.1.2",
    "cypress": "^15.14.2",
    "cypress-axe": "^1.7.0",
    "eslint": "^9.34.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-storybook": "10.4.2",
    "fast-glob": "^3.3.3",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "modern-css-reset": "^1.4.0",
    "next": "^16.2.7",
    "prettier": "^3.5.3",
    "publint": "^0.3.21",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-icons": "^5.5.0",
    "rimraf": "^6.1.3",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-preserve-directives": "^0.4.0",
    "sass": "^1.94.2",
    "sass-embedded": "^1.86.3",
    "sass-loader": "^16.0.5",
    "storybook": "10.4.2",
    "style-loader": "^4.0.0",
    "stylelint": "^16.19.0",
    "stylelint-config-standard-scss": "^14.0.0",
    "stylelint-scss": "^6.11.1",
    "ts-jest": "^29.4.9",
    "ts-morph": "^27.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^6.4.1",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vitest": "^4.1.8",
    "webpack": "^5.99.6",
    "webpack-cli": "^6.0.1"
  },
  "overrides": {
    "storybook": "$storybook"
  },
  "private": true,
  "dependencies": {
    "uuid": "^14.0.0"
  }
}
