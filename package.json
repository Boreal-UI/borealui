  "license": "MIT",
  "main": "./dist/core/index.cjs.js",
  "module": "./dist/core/index.js",
  "types": "./dist/types/index.core.d.ts",
  "type": "module",
  "bin": {
    "boreal-ui": "./packages/cli/src/index.js",
    "create-boreal-ui": "./packages/cli/src/index.js"
  },
