{
  "name": "@boreal-ui/next",
  "version": "0.0.9011",
  "readme": "README.md",
  "description": "Next.js components for Boreal UI",
  "author": "Davin Chiupka",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/next/index.js",
  "module": "./dist/next/index.js",
  "types": "./dist/types/index.d.ts",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "peerDependencies": {
    "@boreal-ui/types": "0.0.9011",
    "marked": ">=12.0.0",
    "next": ">=13.0.0",
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0",
    "uuid": ">=9.0.0"
  },
  "peerDependenciesMeta": {
    "@boreal-ui/types": {
      "optional": true
    }
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/next/index.js"
    },
    "./globals": {
      "types": "./dist/types/next/globals.d.ts",
      "import": "./dist/next/globals.js"
    },
    "./globals.css": {
      "style": "./dist/next/globals.css",
      "default": "./dist/next/globals.css"
    },
    "./types": {
      "types": "./dist/types/public.types.d.ts",
      "default": "./dist/empty.js"
    },
    "./*": {
      "types": "./dist/types/next/*.d.ts",
      "import": "./dist/next/*.js"
    }
  }
}
