{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": true,
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "paths": {
      "@/*": ["./src/*"]
    },

    "types": ["node", "jest", "jest-axe", "@testing-library/jest-dom"],

    "forceConsistentCasingInFileNames": true,
    "plugins": [{ "name": "next" }]
  },

  "include": [
    "src/**/*",
    "__tests__/**/*",
    "stories-core/**/*",
    "stories-next/**/*",
    ".storybook/**/*",
    ".storybook-core/**/*",
    ".storybook-next/**/*",
    "vite.config.ts",
    "vite.config.core.ts",
    "vite.config.next.ts",
    "vite.config.docs.ts",
    "global.d.ts",
    "vite-env.d.ts",
    "shared-story-assets/OptionTypes.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "coverage",
    "storybook-static",
    ".storybook-static"
  ]
}
