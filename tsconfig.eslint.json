{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [
      "node",
      "jest",
      "jest-axe",
      "@testing-library/jest-dom",
      "cypress"
    ]
  },
  "include": [
    "src/**/*",
    "__tests__/**/*",
    "stories-core/**/*",
    "stories-next/**/*",
    "stories-visual/**/*",
    "visual-regression/**/*",
    ".storybook/**/*",
    ".storybook-core/**/*",
    ".storybook-next/**/*",
    ".storybook-visual/**/*",
    "cypress/**/*",
    "shared-story-assets/**/*",
    "vite.config.ts",
    "vite.config.core.ts",
    "vite.config.next.ts",
    "cypress.config.ts",
    "jest.config.ts",
    "global.d.ts",
    "vite-env.d.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "coverage",
    "storybook-static",
    ".storybook-static"
  ]
}
